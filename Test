<style>
.tech-bg {
    position: relative;
    overflow: hidden;
    padding: 30px 0;
    text-align: center;
    background: radial-gradient(circle at 20% 20%, #0a1a2f, #000);
}

.tech-bg::before {
    content: "";
    position: absolute;
    width: 200%;
    height: 200%;
    background-image:
        radial-gradient(circle, rgba(255,80,0,0.4) 2px, transparent 2px),
        radial-gradient(circle, rgba(0,150,255,0.3) 2px, transparent 2px);
    background-size: 80px 80px;
    animation: moveTech 20s linear infinite;
    opacity: 0.6;
}

@keyframes moveTech {
    from {
        transform: translate(0,0);
    }
    to {
        transform: translate(-100px,-100px);
    }
}

.tech-banner img {
    position: relative;
    z-index: 2;
    border-radius: 0;
}
</style>

<div class="tech-bg">
    <div class="tech-banner">
        <img src="https://raw.githubusercontent.com/Ramiel13/Intune/refs/heads/main/ServiceDesk%20TI_1500x119%20v3-05.jpg"
             alt="ServiceDesk TI">
    </div>
</div>
